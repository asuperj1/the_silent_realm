  "clues": {
    "L1": { "name": "线索·乘客护照", "icon": "📜", "desc": "散落的护照，签发日期全部是废都799年——没有一本更晚的。三本护照的主人都是男性，28~45岁；其中一本的照片上，那张脸像是被水泡过一样模糊不清。" },
    "L2": { "name": "线索·揉皱的便签", "icon": "📜", "desc": "「广播里说去7号车集合——但我刚刚看到7号车门外有东西在动，黑色的、像柏油一样从门缝渗进来。乘务员倒在了过道上，没人敢过去。」——便签的纸张边缘发黑，像是被某种液体浸过。" },
    "L3": { "name": "线索·列车长尸体", "icon": "🩸", "desc": "列车长的尸体仰倒在控制台前，颈部缠绕着半凝固的黑色粘液，勒痕呈现出无数细小的触须状纹路。尸体没有腐败气味，瞳孔却不反光——他不像普通的死者。" },
    "L4": { "name": "线索·日记（一）", "icon": "📓", "desc": "「第三天。广播还在重复一样的话。我已经分不清哪个声音是真的……列车在加速，窗外的黑暗像活的一样在流动。」" },
    "L5": { "name": "线索·日记（二）", "icon": "📓", "desc": "「陈姐说往7号车跑，她被困在末尾的设备间里。那地方门被卡死了，可她还在敲。去找陈姐，她知道怎么出去。」" },
    "L6": { "name": "线索·广播日志", "icon": "📻", "desc": "广播控制面板的系统日志：23:47:00正常广播后，23:47:03信号被外部源劫持。自动广播系统从未恢复控制权——也就是说，这声音不是列车自己的。" },
    "L7": { "name": "线索·陈慧的证言", "icon": "🗣️", "desc": "陈慧告知你们全部真相：那只会模仿人声的生物是「米·戈」，8号车通道口盘踞着它饲养的「修格斯幼体」，而唯一生路在8号车尾的紧急出口。" },
    "L8": { "name": "线索·隧道工程图", "icon": "🗺️", "desc": "工程图标注了紧急疏散通道位于8号车尾侧壁——「掰开侧壁角阀，闭气贴地通过。注意：8号车有东西盘踞在通道口。」图纸边缘沾着半干的黑褐色粘液。" }
